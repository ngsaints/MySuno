{
  "name": "my-suno",
  "version": "1.1.0",
  "description": "MySuno - Estúdio de música e narração com Suno e KIE.AI",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-packager . \"MySuno\" --platform=win32 --arch=x64 --out=dist/exe --overwrite",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:electron": "electron tests/electron-smoke.cjs",
    "build:web": "node scripts/build-web.cjs",
    "preview:web": "node scripts/preview-web.cjs",
    "test:pwa": "electron tests/pwa-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
